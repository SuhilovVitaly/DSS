    {
      "id": "fire.submit",
      "lineKey": "Tutorial.Line.FireSubmit",
      "when": { "phase": "Fire", "minTurn": 1, "after": "fire.target" },
      "complete": "phase-left",
      "anchor": "button:primary",
      "priority": 80
    },
    {
      "id": "salvo.watch",
      "lineKey": "Tutorial.Line.SalvoWatch",
      "when": { "phase": "Salvo", "minTurn": 1 },
      "complete": "phase-left",
      "anchor": "button:primary",
      "priority": 90
    },
    {
      "id": "results.read",
      "lineKey": "Tutorial.Line.ResultsRead",
      "when": { "phase": "Results", "minTurn": 1 },
      "complete": "phase-left",
